# Qaysi mijoz yig'iladi (clients/<nom> papkasi). Bo'sh bo'lsa: demo
WEDDING=demo

# Mehmon javoblarini saqlash uchun Upstash Redis.
# Vercel'da: Storage -> Upstash for Redis -> Connect — o'zgaruvchilar o'zi qo'shiladi.
# Lokal sinov uchun Upstash panelidan nusxa oling (bu faylni GIT'ga qo'shmang!):
REDIS_URL=

# /admin sahifasi paroli
ADMIN_PASSWORD=

# Saytning to'liq manzili (ixtiyoriy). Vercel'da avtomatik aniqlanadi.
SITE_URL=
