# /etc/taklifnoma/env — faqat root o'qiy oladi (chmod 600). Bu faylni GitHub'ga yuklamang!
# O'zgartirgandan keyin: sudo systemctl restart taklifnoma

# Baza: Vercel'dagi bilan AYNAN bir xil qiymat — shunda mavjud javoblar o'z joyida qoladi
REDIS_URL=

# Har mijozning /admin paroli. Nom: ADMIN_PASSWORD__ + papka nomi (katta harf, "-" o'rniga "_")
# ADMIN_PASSWORD__SALIMBOY_JASMINAXON=
# ADMIN_PASSWORD__SANJAR_DILNOZA=

# Boshqaruv paneli (boshqaruv.<domen>): egasining paroli — uzun va murakkab bo'lsin
OWNER_PASSWORD=
# Panel saqlaganda GitHub'ga yozishi uchun token: github.com → Settings → Developer settings →
# Fine-grained tokens → faqat shu repo, "Contents: Read and write"
GITHUB_TOKEN=

# ----------------------------------------------------------------------------------------------
# Telegram bot — mijozlar o'z taklifnomasini o'zi yaratadi (server/bot.js, taklifnoma-bot xizmati)
# ----------------------------------------------------------------------------------------------
# @BotFather → /newbot → bergan token. Shu yerdagina turadi — hech kimga yubormang!
BOT_TOKEN=
# Admin(lar)ning Telegram ID'si (@userinfobot dan). Bir nechta bo'lsa — vergul bilan: 123456789,987654321
# Cheklar va tasdiqlash tugmalari shu ID'larga keladi.
ADMIN_TG_IDS=
# To'lov: mijozga ko'rsatiladigan karta raqami va egasi
PAY_CARD=
PAY_CARD_HOLDER=
# Narx (so'm, faqat raqam)
PRICE=75000
# Qo'shimcha xizmat: Instagram uchun video (so'm)
VIDEO_PRICE=15000
# (ixtiyoriy) To'lov ostidagi qo'shimcha izoh, masalan: "Izohga ismingizni yozing"
PAY_NOTE=
# (ixtiyoriy) "Yordam" bo'limida ko'rsatiladigan aloqa: @username yoki telefon
SUPPORT_CONTACT=
# (ixtiyoriy) To'lanmagan qoralamalar necha kundan keyin o'chiriladi (standart 10)
DRAFT_DAYS=10
# (ixtiyoriy) Mini App manzili — odatda kerak emas: https://boshqaruv.<domen>/app avtomatik
BOT_APP_URL=

# ----------------------------------------------------------------------------------------------
# Instagram Direct AI yordamchi (server/instagram.js). Webhook: https://boshqaruv.<domen>/api/panel/instagram
# Egasiga xabarlar yuqoridagi BOT_TOKEN / ADMIN_TG_IDS orqali keladi.
# ----------------------------------------------------------------------------------------------
# Claude API kaliti (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Meta ilovasi → Instagram → API setup with Instagram login → "Instagram app secret"
IG_APP_SECRET=
# Webhook'ni ulashda o'zingiz o'ylab topadigan so'z (Meta'dagi "Verify token" bilan bir xil)
IG_VERIFY_TOKEN=
# Instagram akkaunt tokeni ("Generate token"). 60 kun amal qiladi — server o'zi yangilab turadi
IG_ACCESS_TOKEN=
# (ixtiyoriy) Model: standart claude-opus-5-5; arzonroq: claude-haiku-5-5
IG_MODEL=
# (ixtiyoriy) Siz Instagram'da o'zingiz yozsangiz, bot o'sha mijoz bilan necha soat jim turadi (standart 12)
IG_PAUSE_HOURS=
# (ixtiyoriy) 0 — bot faqat tinglaydi, javob yozmaydi
IG_ENABLED=
